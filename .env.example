# Wajib: isi dengan API key UserGate yang aktif.
USERGATE_API_KEY=
USERGATE_API_BASE=https://usergate.sandalgurun.web.id/api/v1

# Port di komputer/server host yang dipetakan ke port 8080 container.
PORT=8080

# URL yang dibuka pengguna. Ganti localhost dengan IP/domain server
# agar link pengumpulan bisa dibuka dari perangkat lain.
APP_PUBLIC_URL=http://localhost:8080

# Aktifkan hanya bila berada di belakang reverse proxy tepercaya
# yang meneruskan X-Forwarded-For.
TRUST_PROXY=false
# Aktifkan jika HTTPS sudah disediakan oleh reverse proxy.
COOKIE_SECURE=false
